# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to GitHub (it is already in .gitignore).

# Form service access key (added in Phase 6, e.g. Web3Forms or Formspree)
VITE_FORM_ACCESS_KEY=

# Analytics IDs (added in Phase 7). Leave blank until you have your own real IDs.
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_ID=
